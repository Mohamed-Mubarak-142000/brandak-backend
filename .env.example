NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/brandak?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3001
# Storage: "cloudinary" in production, "local" stores files under ./uploads (development only)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email codes (verify email, reset password) over SMTP. Gmail: smtp.gmail.com, port 465 and an App Password.
# Leave empty in development: codes are written to the server log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# InstaPay receiving details shown to brand owners
INSTAPAY_RECEIVER=01050867135
INSTAPAY_RECEIVER_NAME=Brandak
SUBSCRIPTION_GRACE_DAYS=0
# First super admin (used by npm run seed)
SEED_ADMIN_EMAIL=admin@brandak.local
SEED_ADMIN_PASSWORD=ChangeMe!12345

# Product drafts from a photo (free key from https://aistudio.google.com/apikey). Empty = feature hidden.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=30
